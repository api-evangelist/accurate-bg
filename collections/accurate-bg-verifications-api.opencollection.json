{
  "opencollection": "1.0.0",
  "info": {
    "name": "Accurate Background Adjudication Verifications API",
    "version": "3.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://api.accuratebackground.com/v3/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Verifications",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get verification attempts",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.accuratebackground.com/v3/order/:id/verification-attempts",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve the history of employment and education verification attempts for an order."
        }
      ]
    }
  ],
  "bundled": true
}